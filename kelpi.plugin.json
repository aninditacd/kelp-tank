{
  "id": "dita.kelp-tank",
  "name": "Kelp Tank",
  "version": "0.1.0",
  "apiVersion": 1,
  "trust": "full",
  "activation": "on-demand",
  "backend": "backend.mjs",
  "contributes": {
    "views": [
      {
        "id": "dita.kelp-tank.home",
        "title": "Kelp Tank",
        "entry": "ui/index.html",
        "placements": ["pane", "sidebar.primary", "sidebar.secondary"],
        "stateVersion": 1
      }
    ],
    "commands": [
      {
        "id": "dita.kelp-tank.summary",
        "title": "Kelp Tank: Workspace summary"
      },
      {
        "id": "dita.kelp-tank.quiet",
        "title": "Kelp Tank: Quiet sessions"
      },
      {
        "id": "dita.kelp-tank.hook",
        "title": "Kelp Tank: Hook event (used by its Claude hook)"
      },
      {
        "id": "dita.kelp-tank.agent-book",
        "title": "Kelp Tank: Background agents"
      },
      {
        "id": "dita.kelp-tank.activity",
        "title": "Kelp Tank: Session activity"
      }
    ],
    "cli": [
      {
        "name": "kelp-tank",
        "command": "dita.kelp-tank.hook",
        "summary": "Pass a Claude Code hook event to Kelp Tank. Its hook script calls this."
      }
    ],
    "settings": {}
  }
}
